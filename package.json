{
  "name": "sowing-season",
  "version": "1.0.5",
  "description": "Envelope-style budgeting app — tend your money like a garden",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run release:check && electron-builder",
    "dist:unchecked": "electron-builder",
    "release:check": "node tools/release-check.js",
    "release": "electron-builder --publish always",
    "test": "node tools/test-compute.mjs",
    "test:csv": "node tools/test-csv.mjs",
    "dev": "node tools/dev-server.js",
    "test:garden": "node tools/test-garden.mjs",
    "test:migrate": "node tools/test-migrate.mjs"
  },
  "keywords": [],
  "author": "sowingseasonapp",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "xlsx": "^0.18.5"
  },
  "productName": "Sowing Season",
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "com.sowingseason.app",
    "productName": "Sowing Season",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "legacy-data.js",
      "updater.js",
      "package.json",
      "src/**/*",
      "!src/dev.html",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Sowing-Season-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "darkModeSupport": true
    },
    "dmg": {
      "artifactName": "Sowing-Season-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "sowingseasonapp",
      "repo": "sowing-season"
    }
  }
}
